{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "title": "Ollama Requests / Minute",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (status) (rate(mhc_ollama_chat_requests_total[5m]) * 60)", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []}
    },
    {
      "title": "Chat Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, model) (rate(mhc_ollama_chat_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{model}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "title": "Token Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by (model) (rate(mhc_ollama_input_tokens_total[5m]))", "legendFormat": "input {{model}}", "refId": "A"},
        {"expr": "sum by (model) (rate(mhc_ollama_output_tokens_total[5m]))", "legendFormat": "output {{model}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "tps"}, "overrides": []}
    },
    {
      "title": "Ollama Generation and Load Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, model) (rate(mhc_ollama_eval_duration_seconds_bucket[5m])))", "legendFormat": "eval p95 {{model}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, model) (rate(mhc_ollama_load_duration_seconds_bucket[5m])))", "legendFormat": "load p95 {{model}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "title": "Ollama Availability",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "targets": [{"expr": "mhc_ollama_available", "legendFormat": "{{model}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Down"}, "1": {"text": "Up"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}, "overrides": []}
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["mhc", "ollama"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "MHC Ollama Usage",
  "uid": "mhc-ollama-usage",
  "version": 1
}
